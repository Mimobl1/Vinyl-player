{
  "cleanUrls": false,
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/player", "destination": "/vinyl-player.html" },
    { "source": "/archive", "destination": "/archive.html" },
    { "source": "/admin-milan", "destination": "/admin-milan/index.html" }
  ],
  "headers": [
    {
      "source": "/vinyl-collection.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/collection",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ]
}
